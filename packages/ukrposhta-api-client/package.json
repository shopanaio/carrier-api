{
  "name": "@shopana/ukrposhta-api-client",
  "version": "1.0.0",
  "description": "Typed Ukrposhta API client: eCom, status tracking and address classifier",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "contracts/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run clean && rollup -c rollup.config.mjs && tsc -p tsconfig.json --emitDeclarationOnly",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.tests.json",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:e2e": "jest --config jest.e2e.config.js --passWithNoTests",
    "generate": "node scripts/generate-contract.mjs && prettier --write \"src/contract/generated/*.ts\""
  },
  "keywords": [
    "carrier",
    "carrier-api",
    "shipping",
    "logistics",
    "ukrposhta",
    "typescript"
  ],
  "author": "Shopana.io",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/shopanaio/carrier-api.git",
    "directory": "packages/ukrposhta-api-client"
  },
  "bugs": {
    "url": "https://github.com/shopanaio/carrier-api/issues"
  },
  "homepage": "https://github.com/shopanaio/carrier-api/tree/main/packages/ukrposhta-api-client#readme",
  "dependencies": {
    "@shopana/carrier-core": "^1.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./public": {
      "types": "./dist/public/index.d.ts",
      "import": "./dist/public/index.mjs",
      "require": "./dist/public/index.cjs"
    },
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "import": "./dist/contract/index.mjs",
      "require": "./dist/contract/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
