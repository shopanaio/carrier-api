{
  "name": "@shopana/novaposhta-api-client",
  "version": "0.0.1",
  "description": "Fully typed Nova Poshta API client for Node.js and browsers with enterprise-grade features",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run clean && rollup -c rollup.config.mjs && tsc -p tsconfig.json --emitDeclarationOnly",
    "clean": "rm -rf dist",
    "dev": "rollup -c rollup.config.mjs --watch",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "nova-poshta",
    "novaposhta",
    "shipping",
    "logistics",
    "delivery",
    "tracking",
    "api-client",
    "sdk",
    "rest-api",
    "api-wrapper",
    "carrier",
    "carrier-api",
    "courier",
    "parcel",
    "waybill",
    "package-tracking",
    "shipping-api",
    "ecommerce",
    "ukraine",
    "typescript",
    "type-safe",
    "nodejs",
    "browser",
    "esm",
    "plugin-architecture",
    "tree-shakeable"
  ],
  "author": "Shopana.io",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/shopanaio/carrier-api.git",
    "directory": "packages/novaposhta-api-client"
  },
  "bugs": {
    "url": "https://github.com/shopanaio/carrier-api/issues"
  },
  "homepage": "https://github.com/shopanaio/carrier-api/tree/main/packages/novaposhta-api-client#readme",
  "dependencies": {
    "@shopana/carrier-core": "^0.0.1"
  },
  "devDependencies": {},
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
